{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "web-data-bench.vercel.app" }],
      "destination": "https://www.scrapingbench.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "web-bench-zeta.vercel.app" }],
      "destination": "https://www.scrapingbench.com/:path*",
      "statusCode": 301
    }
  ]
}
